      "vat_returns": 450,
      "payroll": 360,
      "mtd_quarterly": 300,
      "advisory": 600
    },
    "turnover_bands": [
      {"max": 50000, "multiplier": 1.0},
      {"max": 250000, "multiplier": 1.3},
      {"max": 1000000, "multiplier": 1.7},
      {"max": null, "multiplier": 2.2}
    ],
    "records_multiplier": {"organised": 1.0, "mostly": 1.15, "messy": 1.4},
