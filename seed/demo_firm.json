    {"field": "business_type", "op": "in", "value": ["sole_trader", "landlord"], "points": 5, "reason": "Sole trader or landlord"},
    {"field": "business_type", "op": "eq", "value": "individual", "points": -15, "reason": "Personal tax only (low fee)"},
    {"field": "turnover", "op": "gte", "value": 100000, "points": 15, "reason": "Turnover £100k or more"},
    {"field": "turnover", "op": "lte", "value": 20000, "points": -10, "reason": "Turnover under £20k"},
    {"field": "software", "op": "in", "value": ["xero", "quickbooks", "freeagent"], "points": 10, "reason": "Already on cloud software we support"},
    {"field": "software", "op": "in", "value": ["paper", "none"], "points": -15, "reason": "No digital records (MTD workload)"},
    {"field": "records_state", "op": "eq", "value": "organised", "points": 10, "reason": "Records are organised"},
    {"field": "records_state", "op": "eq", "value": "messy", "points": -15, "reason": "Messy records"},
    {"field": "days_to_deadline", "op": "lte", "value": 21, "points": -20, "reason": "Deadline within 3 weeks"},
    {"field": "services", "op": "contains_any", "value": ["bookkeeping", "payroll", "advisory"], "points": 10, "reason": "Wants recurring services"}
  ],
  "pricing": {
    "base": {
      "sole_trader": 450,
